DirectoryIndex index.php public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /hr/

    # Disable directory indexing
    Options -Indexes

    # Rewrite root and subfolder requests to public/
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

# Security: Block sensitive files
<FilesMatch "^\.(env|git|cpanel)|composer\.(json|lock)|package(-lock)?\.json">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to internal directories
RedirectMatch 403 ^/hr/(app|bootstrap|config|database|resources|routes|storage|tests|Modules)/

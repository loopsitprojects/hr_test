<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct HTTP access to internal framework directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(\/|$) - [F,L,NC]

    # Block access to hidden or sensitive files
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(env|json|lock|sql|md|yml|yaml|xml|bak|swp)$ - [F,L,NC]

    # Rewrite all traffic into the public/ directory front controller
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/hr/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback directory protection
<FilesMatch "(^\.env|\.sql|\.json|\.lock|\.md|\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
